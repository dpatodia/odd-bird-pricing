# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Supabase -> Account (top-right avatar) -> Access Tokens -> Generate new token
SUPABASE_ACCESS_TOKEN=
# Supabase -> your NEW odd-bird-pricing project -> Project Settings -> General -> "Project ID"
SUPABASE_PROJECT_REF=

# Your own login (admin: can change costs, fees, targets; can delete sales weeks)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Teammate logins (members: see everything, can add or correct weekly sales).
# Format: email:password:Name, separated by commas. No spaces. Passwords must not contain : or ,
TEAM_LOGINS=

# GitHub -> Settings -> Developer settings -> Fine-grained token with Administration, Contents, Pages, Workflows = Read & write
GITHUB_TOKEN=
GITHUB_REPO=YOUR_GITHUB_USERNAME/odd-bird-pricing
